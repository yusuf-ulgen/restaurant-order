# Multi-stage Dockerfile for ASP.NET Core 10 API
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY ["apps/api/RestaurantOrder.Api.csproj", "apps/api/"]
COPY ["packages/domain/RestaurantOrder.Domain.csproj", "packages/domain/"]
COPY ["packages/application/RestaurantOrder.Application.csproj", "packages/application/"]
COPY ["packages/infrastructure/RestaurantOrder.Infrastructure.csproj", "packages/infrastructure/"]
RUN dotnet restore "apps/api/RestaurantOrder.Api.csproj"

COPY apps/api/ apps/api/
COPY packages/domain/ packages/domain/
COPY packages/application/ packages/application/
COPY packages/infrastructure/ packages/infrastructure/
WORKDIR /src/apps/api
RUN dotnet publish "RestaurantOrder.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000

# Create non-root system user and enforce unprivileged execution
RUN addgroup -g 10001 appgroup && adduser -u 10001 -G appgroup -s /sbin/nologin -D appuser
USER appuser

COPY --from=build --chown=appuser:appgroup /app/publish .
ENTRYPOINT ["dotnet", "RestaurantOrder.Api.dll"]
