# Multi-stage Dockerfile for ASP.NET Core 10 API
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY ["apps/api/RestaurantOrder.Api.csproj", "apps/api/"]
RUN dotnet restore "apps/api/RestaurantOrder.Api.csproj"

COPY apps/api/ apps/api/
WORKDIR /src/apps/api
RUN dotnet publish "RestaurantOrder.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
WORKDIR /app
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "RestaurantOrder.Api.dll"]
