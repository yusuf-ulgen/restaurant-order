{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/yusuf-ulgen/restaurant-order/docs/schemas/release-manifest.schema.json",
  "title": "Release Manifest",
  "description": "Schema for restaurant-order CI/CD release manifests. Describes all 5 production images with immutable sha256 digests.",
  "type": "object",
  "required": ["version", "releaseId", "createdAt", "images"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the release (e.g. '1.2.3')",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "releaseId": {
      "type": "string",
      "description": "Unique identifier for this release (e.g. 'rel-1.2.3-20260919')"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this manifest was generated by CI/CD"
    },
    "gitSha": {
      "type": "string",
      "description": "Git commit SHA that produced this release"
    },
    "images": {
      "type": "object",
      "description": "Map of image keys to image metadata. All 5 keys are required.",
      "required": ["api", "worker", "customer-web", "operations-web", "admin-web"],
      "additionalProperties": false,
      "properties": {
        "api": { "$ref": "#/$defs/imageEntry" },
        "worker": { "$ref": "#/$defs/imageEntry" },
        "customer-web": { "$ref": "#/$defs/imageEntry" },
        "operations-web": { "$ref": "#/$defs/imageEntry" },
        "admin-web": { "$ref": "#/$defs/imageEntry" }
      }
    }
  },
  "$defs": {
    "imageEntry": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "description": "Full registry/repository path (e.g. 'ghcr.io/org/image')"
        },
        "tag": {
          "type": "string",
          "description": "Image tag (e.g. 'v1.2.3'). 'latest' is forbidden in production."
        },
        "digest": {
          "type": "string",
          "description": "Immutable sha256 digest (sha256:<64 hex chars>). Placeholder and empty-content hashes are rejected at preflight.",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
