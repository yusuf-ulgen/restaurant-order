# ==============================================================================
# BACKGROUND WORKER ENVIRONMENT CONTRACT (apps/worker/.env.example)
# ==============================================================================
# Injected into .NET 10 Background Worker host.
# ==============================================================================

# Description: Hosting environment mode.
# Required: Yes (All environments)
# Secret: No
# Allowed: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Description: PostgreSQL connection string.
# Required: Yes (All environments)
# Secret: Yes in Staging & Production
DATABASE_URL=Host=localhost;Port=5432;Database=restaurant_order_dev;Username=postgres;Password=postgres

# Description: Redis cache and distributed lock connection string.
# Required: Yes (All environments)
# Secret: Yes in Staging & Production
REDIS_URL=localhost:6379

# Description: Deployment color assigned to this worker instance.
# Required: Yes in Staging & Production; defaults to blue in Development
# Secret: No
# Allowed: blue | green
DEPLOYMENT_COLOR=blue

# Description: Currently active deployment slot authorized to consume queues.
# Required: Yes in Staging & Production; defaults to DEPLOYMENT_COLOR in Development
# Secret: No
# Allowed: blue | green
ACTIVE_DEPLOYMENT_SLOT=blue

# Description: Kill-switch flag to completely disable worker processing.
# Required: No (Default: true)
# Secret: No
WORKER_ENABLED=true

# Description: Logging verbosity level.
# Required: No (Default: Information)
# Secret: No
LOG_LEVEL=Information
