# ==============================================================================
# OPERATIONS WEB APP ENVIRONMENT CONTRACT (apps/operations-web/.env.example)
# ==============================================================================
# Injected into Vite at build/runtime.
# SECURITY NOTICE: Only VITE_ prefixed variables are bundled into client code.
# NEVER add database credentials, private keys, or backend secrets here.
# ==============================================================================

# Description: Backend API base URL accessible by staff/waiter browsers.
# Required: Yes (All environments)
# Secret: No (Public)
VITE_API_URL=http://localhost:5000

# Description: Environment label displayed on staff UI badges.
# Required: No (Default: local)
# Secret: No (Public)
VITE_ENVIRONMENT=local

# Description: Public application display title.
# Required: No (Default: Operations & Waiter Portal)
# Secret: No (Public)
VITE_APP_TITLE=Operations & Waiter Portal
