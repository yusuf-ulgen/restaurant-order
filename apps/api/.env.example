# ==============================================================================
# API SERVICE ENVIRONMENT CONTRACT (apps/api/.env.example)
# ==============================================================================
# Injected into ASP.NET Core 10 Web API host.
# ==============================================================================

# Description: ASP.NET Core runtime environment.
# Required: Yes (All environments)
# Secret: No
# Allowed: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Description: API listening port.
# Required: No (Default: 5000)
# Secret: No
PORT=5000

# Description: PostgreSQL connection string.
# Required: Yes (All environments)
# Secret: Yes in Staging & Production
DATABASE_URL=Host=localhost;Port=5432;Database=restaurant_order_dev;Username=postgres;Password=postgres

# Description: Redis cache and SignalR coordination connection string.
# Required: Yes (All environments)
# Secret: Yes in Staging & Production
REDIS_URL=localhost:6379

# Description: Secret key for signing and validating JWT tokens.
# Required: Yes in Staging & Production; dev fallback in Local
# Secret: Yes
JWT_SECRET=dev-only-insecure-jwt-secret-min-32-chars-long!

# Description: JWT Issuer identifier.
# Required: No (Default: restaurant-order)
# Secret: No
JWT_ISSUER=restaurant-order

# Description: JWT Audience identifier.
# Required: No (Default: restaurant-order-clients)
# Secret: No
JWT_AUDIENCE=restaurant-order-clients

# Description: Deployment color assigned to this API instance (blue or green).
# Required: Yes in Staging & Production; defaults to blue in Development
# Secret: No
# Allowed: blue | green
DEPLOYMENT_COLOR=blue

# Description: Logging verbosity level.
# Required: No (Default: Information)
# Secret: No
LOG_LEVEL=Information
